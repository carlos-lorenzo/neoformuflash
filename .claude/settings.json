{
    "env": {
        "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
        "ANTHROPIC_AUTH_TOKEN": "sk-d73f82b5163eb00b-43bbc3-fd5933ff",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL":  "auto",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "auto/coding",
        "ANTHROPIC_DEFAULT_OPUS_MODEL":   "cc/claude-opus-5"
      },
  "$comment": "Project-scoped, committed to git. Personal overrides go in .claude/settings.local.json (gitignored).",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npx playwright:*)",
      "Bash(supabase:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(supabase db reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": ".claude/hooks/secret-guard.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": ".claude/hooks/notify.sh" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": ".claude/hooks/cost-log.sh" }] }
    ]
  }
}
